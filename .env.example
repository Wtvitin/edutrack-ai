# Copy to .env.local. Never commit credentials.
APP_ORIGIN=http://localhost:4173
PORT=4173
UI_PORT=4174
# Local testing: emails appear at /emails-locais, never sent externally.
MAIL_MODE=local
# To send with Gmail: set MAIL_MODE=smtp and configure an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Optional Resend transport: set MAIL_MODE=resend and configure this key.
RESEND_API_KEY=
# Optional conventional PostgreSQL; empty uses server-side embedded PostgreSQL.
DATABASE_URL=
DATA_DIR=.local/postgres
# Python with analytics/requirements.txt installed; full executable path also works.
PYTHON_BIN=python

# Agent LLM integration. Keep all keys server-side; leave empty for mocked tests/offline demo.
# Gemini is the default and normal runtime provider. OpenRouter is explicit compatibility only.
LLM_PROVIDER=google-gemini
LLM_MODEL=gemini-2.5-flash
LLM_FALLBACK_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_MS=30000
# Google AI Studio/Gemini API key; server-side only.
GOOGLE_API_KEY=
# Optional legacy compatibility only when LLM_PROVIDER=openrouter.
OPENROUTER_API_KEY=

# Classroom OAuth (separate from Gemini and Gmail SMTP).
# JSON must remain outside the repository. Redirect = APP_ORIGIN/api/integrations/google/callback.
GOOGLE_CLASSROOM_CREDENTIALS_FILE=
# Production: a stable, random 32-byte key in base64. Keep separate from the database.
CLASSROOM_TOKEN_ENCRYPTION_KEY=
# Local development generates a binary key here; back it up with the database.
CLASSROOM_TOKEN_KEY_FILE=.local/classroom-token.key

# Optional Groq provider. Select it explicitly with LLM_PROVIDER=groq.
# GROQ_MODEL has no runtime default; configure a model compatible with Tools and Structured Output.
GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=
GROQ_TIMEOUT_MS=
